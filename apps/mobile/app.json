{
  "expo": {
    "name": "Nhip Nha",
    "slug": "nhip-nha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#FCF6EE",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dhp.sunlit.tulip.nhipnha",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Nhịp Nhà",
        "NSCameraUsageDescription": "Nhịp Nhà cần quyền máy ảnh để quét mã QR gia đình và chụp ảnh chia sẻ trong Nhật ký 15 giây.",
        "NSMicrophoneUsageDescription": "Nhịp Nhà cần quyền micro để ghi âm lời chào buổi sáng và Nhật ký giọng nói 15 giây gửi cho gia đình.",
        "NSPhotoLibraryUsageDescription": "Nhịp Nhà cần quyền thư viện ảnh để đính kèm hình vẽ hoặc bức ảnh trong ngày."
      },
      "splash": {
        "image": "./assets/icon.png",
        "backgroundColor": "#FCF6EE",
        "resizeMode": "contain"
      }
    },
    "android": {
      "package": "dhp.sunlit.tulip.nhipnha",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DF5018"
      },
      "splash": {
        "image": "./assets/icon.png",
        "backgroundColor": "#FCF6EE",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Nhịp Nhà cần quyền máy ảnh để quét mã QR gia đình và chụp ảnh gửi cha mẹ."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nhịp Nhà cần quyền truy cập ảnh để bạn chọn ảnh đính kèm tin nhắn gia đình.",
          "cameraPermission": "Nhịp Nhà cần quyền chụp ảnh qua máy ảnh hệ thống để bạn chia sẻ khoảnh khắc trong ngày."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Nhịp Nhà cần quyền micro để gửi tin nhắn giọng nói 15s cho cha mẹ."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1024m",
              "android.useAndroidX": "true",
              "android.enableJetifier": "true",
              "android.lint.abortOnError": "false",
              "android.lint.checkReleaseBuilds": "false"
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ]
  }
}
